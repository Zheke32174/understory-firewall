<?xml version="1.0" encoding="utf-8"?>
<!--
  Anonymity (Tor + i2pd) copy — WP-4.

  Section-scoped file: Android merges every res/values/*.xml, so this section owns its own
  strings under the anon_ prefix and never edits the shared strings.xml (a concurrent edit to
  that file already broke CI once this session).

  The preference titles and summaries mirror InviZible Pro's preferences_tor and
  preferences_i2pd verbatim (github.com/Gedsh/InviZible, GPL-3.0) — they are the real donor
  option surface WP-9 renders. The honest-gating sentences (what is absent, what is only
  stored) are dynamic and come from the engine (Anonymity.explain / routingEnforcement); the
  few static banners here state the REACH of the control, per the house rule.
-->
<resources>

    <!-- ── Capability, top level ──────────────────────────────────────────────────────── -->
    <string name="anon_title">Anonymity</string>
    <string name="anon_tor">Tor</string>
    <string name="anon_i2pd">Purple I2P</string>
    <string name="anon_new_identity">New Tor identity</string>
    <string name="anon_advanced_warning">For advanced user only!</string>

    <!-- Honest banners. The engine fills the exact absent/stored reason at runtime; these are
         the fixed reach statements a screen shows beside the controls. -->
    <string name="anon_reach_tor">Runs the Tor client as uid 2000 in Godwall\'s own prefix and binds a local SOCKS/DNS proxy the tun dials into. It anonymises only the flows the routing policy steers to it.</string>
    <string name="anon_reach_i2pd">Runs the i2pd router as uid 2000 and serves local HTTP and SOCKS proxies for reaching .i2p services. It does not route device traffic on its own.</string>
    <string name="anon_routing_stored_no_datapath">These selections are saved, but not yet enforced: steering an app\'s or a site\'s traffic into Tor needs a full-traffic tunnel, and Godwall\'s tunnel carries DNS only in this build.</string>
    <string name="anon_bridges_absent">This obfuscation needs a pluggable-transport binary that is not in this build. The control stays disabled until it is added.</string>

