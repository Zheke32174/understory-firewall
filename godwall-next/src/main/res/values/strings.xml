    <!-- Privilege -->
    <string name="priv_attached">Privileged shell attached</string>
    <string name="priv_not_attached">No privileged shell attached</string>
    <string name="priv_broker_absent">Yojimbo is not installed</string>
    <string name="priv_how">Where privilege comes from</string>
    <string name="priv_how_body">Yojimbo, and nowhere else. Yojimbo runs the suite\'s privileged
        server and pushes a shell into Godwall over a signature-locked channel; both apps must
        carry the same signing certificate. Godwall does not ask Shizuku or Dhizuku — Yojimbo
        replaces those, so reaching around it would mean neither app had replaced
        anything.</string>
    <string name="priv_without">What works without it</string>
    <string name="priv_without_body">Everything Godwall does today: the DNS filter, the encrypted
        upstream, per-app blackhole and bypass, the egress chain, and the mesh node. A privileged
        shell adds packet-level enforcement — until one is attached, those controls are absent
        rather than present and inert.</string>

